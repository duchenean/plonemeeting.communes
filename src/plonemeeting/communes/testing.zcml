<configure xmlns="http://namespaces.zope.org/zope"
           xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
           i18n_domain="MeetingCommunes">

    <include file="configure.zcml"/>

    <genericsetup:registerProfile
        name="testing"
        title="PloneMeeting / Communes for unit tests : do not use manually"
        description="PloneMeeting for City College and Council (Belgium) : unit test only"
        directory="profiles/testing"
        provides="Products.GenericSetup.interfaces.EXTENSION"
        for="Products.CMFCore.interfaces.ISiteRoot"/>

    <!-- Import steps (registered via ZCML for Plone 6 compat) -->
    <genericsetup:importStep
        name="installMeetingCommunes"
        title="Install MeetingCommunes."
        description="Install MeetingCommunes."
        handler="plonemeeting.communes.setuphandlers.installMeetingCommunes" />

    <genericsetup:importStep
        name="initializetool-MeetingCommunes"
        title="Initialize MeetingCommunes with examples."
        description="Initialize portal_plonemeeting folders."
        handler="plonemeeting.communes.setuphandlers.initializeTool">
      <depends name="installMeetingCommunes" />
    </genericsetup:importStep>

</configure>
